{
  "name": "dynastywire-ingest",
  "version": "0.1.0",
  "private": true,
  "description": "CFB27 dynasty save -> DynastySnapshot + week delta. Runs as the Tauri sidecar.",
  "type": "commonjs",
  "bin": {
    "dw-ingest": "cli.js"
  },
  "scripts": {
    "snapshot": "node cli.js snapshot",
    "delta": "node cli.js delta"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "madden-franchise": "^4.3.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  },
  "pkg": {
    "scripts": ["gen/**/*.js"],
    "assets": ["node_modules/madden-franchise/data/**/*"],
    "targets": ["node20-win-x64"],
    "outputPath": "dist"
  }
}
